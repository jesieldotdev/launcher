{
  "id": "relogio-material-you-oficial",
  "name": "Relógio Material You",
  "author": "Launcher",
  "description": "Relógio nas cores do sistema (Material You).",
  "role": "DESKTOP",
  "interactive": false,
  "network": true,
  "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&display=swap');\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    overflow: hidden;\n    background: transparent;\n  }\n\n  .terminal {\n    /* Diminua este valor para deixar mais transparente */\n    --fundo: .55;\n    /* Cores do Material You (mudam com o papel de parede e com o modo claro/escuro) */\n    --cor: var(--corPrimaria);\n    --texto: var(--corTexto);\n    --suave: var(--corTextoSuave);\n\n    width: 100%;\n    height: 100%;\n    position: relative;\n    overflow: hidden;\n    container-type: size;\n    color: var(--cor);\n    font-family: 'Orbitron', 'Courier New', monospace;\n    border: 1px solid color-mix(in srgb, var(--cor) 35%, transparent);\n    border-radius: 16px;\n    background: transparent;\n    box-shadow:\n      inset 0 0 35px rgba(0, 0, 0, .25),\n      inset 0 1px 0 color-mix(in srgb, var(--cor) 12%, transparent);\n    isolation: isolate;\n  }\n\n  .terminal::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n    opacity: var(--fundo);\n    background:\n      radial-gradient(\n        ellipse at center,\n        var(--corPrimariaFundo) 0%,\n        var(--corSuperficie) 65%,\n        var(--corFundo) 100%\n      );\n  }\n\n  .terminal::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 2;\n    background: repeating-linear-gradient(\n      to bottom,\n      transparent 0px,\n      transparent 3px,\n      rgba(0, 0, 0, .18) 3px,\n      rgba(0, 0, 0, .18) 4px\n    );\n    box-shadow: inset 0 0 45px rgba(0, 0, 0, .2);\n  }\n\n  .layout {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    padding: 4cqh 4cqw;\n  }\n\n  .top, .bottom {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    font-size: clamp(10px, 4cqh, 22px);\n    font-weight: 500;\n    letter-spacing: .08em;\n    text-shadow: 0 1px 4px rgba(0, 0, 0, .8);\n  }\n\n  .top {\n    padding-bottom: 3cqh;\n    border-bottom: 1px solid color-mix(in srgb, var(--cor) 25%, transparent);\n  }\n\n  .signal {\n    display: inline-block;\n    width: .55em;\n    height: .55em;\n    margin-right: .5em;\n    background: var(--cor);\n    box-shadow: 0 0 10px var(--cor);\n  }\n\n  .clock {\n    flex: 1;\n    min-height: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    white-space: nowrap;\n    font-size: min(25cqw, 47cqh);\n    line-height: 1;\n    font-weight: 600;\n    letter-spacing: -.04em;\n    padding-right: .04em;\n    font-variant-numeric: tabular-nums;\n    text-shadow:\n      0 2px 5px rgba(0, 0, 0, .5),\n      0 0 3px color-mix(in srgb, var(--cor) 60%, white),\n      0 0 18px color-mix(in srgb, var(--cor) 45%, transparent),\n      3px 0 0 color-mix(in srgb, var(--corTerciaria) 15%, transparent);\n  }\n\n  .date {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n    padding-bottom: 3cqh;\n    font-size: clamp(11px, 4.5cqh, 25px);\n    font-weight: 400;\n    text-shadow: 0 1px 4px rgba(0, 0, 0, .8);\n  }\n\n  .greeting {\n    color: var(--texto);\n  }\n\n  .bottom {\n    padding-top: 3cqh;\n    border-top: 1px solid color-mix(in srgb, var(--cor) 25%, transparent);\n    color: var(--suave);\n    font-size: clamp(9px, 3.2cqh, 18px);\n  }\n\n  .battery {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    white-space: nowrap;\n  }\n\n  .meter {\n    width: 11cqw;\n    height: .65em;\n    padding: 2px;\n    border: 1px solid color-mix(in srgb, var(--suave) 50%, transparent);\n  }\n\n  .meter-fill {\n    height: 100%;\n    width: clamp(0%, calc(var(--bateria, 0) * 1%), 100%);\n    background: var(--cor);\n    box-shadow: 0 0 8px color-mix(in srgb, var(--cor) 40%, transparent);\n  }\n</style>\n\n<div class=\"terminal\">\n  <div class=\"layout\">\n    <div class=\"top\">\n      <span><span class=\"signal\"></span>LOCAL TIME</span>\n      <span>{{ano}} / CLOCK_01</span>\n    </div>\n\n    <div class=\"clock\">{{hora}}</div>\n\n    <div class=\"date\">\n      <span class=\"greeting\">{{saudacao}}</span>\n      <span>{{data}}</span>\n    </div>\n\n    <div class=\"bottom\">\n      <span>● SISTEMA ONLINE</span>\n      <div class=\"battery\">\n        <span>BAT {{bateria}}%</span>\n        <div class=\"meter\">\n          <div class=\"meter-fill\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
  "issue": 0,
  "updated": "2026-10-14"
}